# --- API keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Models ---
GEMINI_MODEL=gemini-2.5-flash
WHISPER_MODEL=whisper-1

# --- Limits ---
MAX_DURATION_SECONDS=180
MAX_UPLOAD_MB=50
MAX_CLAIMS=8

# --- Paths ---
TEMP_DIR=./tmp
CACHE_DIR=./cache

# --- Whisper Hallucination & Silence Filter Tuning ---
NO_SPEECH_THRESHOLD=0.6
LOGPROB_THRESHOLD=-1.0
HALLUCINATION_PHRASES="thank you for watching,thanks for watching,subtitles by,amara.org,subscribe to my channel"

# --- API (Phase 4) ---
FRONTEND_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_HOUR=5
JOB_TIMEOUT_SECONDS=180
CACHE_TTL_HOURS=24
